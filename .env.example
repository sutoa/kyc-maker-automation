# KYC Document Processing - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration (Constitution Principle IX: Model-Agnostic AI)
# =============================================================================
# Select which LLM provider to use: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI Configuration (required if LLM_PROVIDER=openai)
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini Configuration (required if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# =============================================================================
# Database Configuration
# =============================================================================
# SQLite database URL for MVP (FR-029: 7-year retention)
DATABASE_URL=sqlite:///./kyc_workflows.db

# =============================================================================
# Application Settings
# =============================================================================
# Directory for uploaded documents
UPLOAD_DIR=./uploads

# Directory for generated output files
OUTPUT_DIR=./output

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# API Configuration
# =============================================================================
# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# Workflow Configuration
# =============================================================================
# Maximum retry attempts per agent step (FR-010)
MAX_RETRY_ATTEMPTS=4

# LLM retry attempts for transient failures
LLM_RETRY_ATTEMPTS=3

# LLM retry backoff settings (seconds)
LLM_RETRY_MIN_WAIT=2
LLM_RETRY_MAX_WAIT=30
