{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent.schema.json",
  "title": "Agent Configuration Schema v1.2",
  "description": "Schema for validating KYC workflow agents.yaml (AGENTFLOW v1.2)",
  "definitions": {
    "retryConfig": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Maximum retry attempts before failing"
        },
        "backoff": {
          "type": "string",
          "enum": ["linear", "exponential", "fixed"],
          "description": "Backoff strategy between retries"
        },
        "delay_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Initial delay in seconds between retries"
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "LiteLLM model string (e.g. openai/gpt-4o-mini)"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "LLM temperature"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128000,
          "description": "Maximum output tokens"
        },
        "retry": {
          "$ref": "#/definitions/retryConfig"
        }
      },
      "additionalProperties": false
    },
    "systemPrompt": {
      "type": "object",
      "oneOf": [
        {
          "required": ["file"],
          "properties": {
            "file": {
              "type": "string",
              "description": "Relative path to prompt markdown file"
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["inline"],
          "properties": {
            "inline": {
              "type": "string",
              "description": "Prompt text embedded directly"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "required": ["ref"],
          "properties": {
            "ref": {
              "type": "string",
              "description": "Fully-qualified Pydantic class (e.g. src.models.person.ExtractedPerson)"
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["example"],
          "properties": {
            "example": {
              "type": "object",
              "description": "Sample JSON object; schema inferred at runtime"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "agent": {
      "type": "object",
      "required": ["role", "goal", "backstory", "input_keys", "output_key", "system_prompt"],
      "properties": {
        "role": {
          "type": "string",
          "description": "Professional identity injected into system prompt"
        },
        "goal": {
          "type": "string",
          "description": "Primary objective; supports {var} interpolation"
        },
        "backstory": {
          "type": "string",
          "description": "Background context that shapes agent behaviour"
        },
        "model": {
          "type": "string",
          "description": "LiteLLM model string; overrides defaults.model"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "LLM temperature; overrides defaults.temperature"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128000,
          "description": "Max output tokens; overrides defaults.max_tokens"
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tool keys from the workflow tools registry"
        },
        "input_keys": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "State keys this agent reads as context"
        },
        "output_key": {
          "type": "string",
          "description": "State key this agent writes its result to"
        },
        "output_schema": {
          "$ref": "#/definitions/outputSchema"
        },
        "system_prompt": {
          "$ref": "#/definitions/systemPrompt"
        },
        "retry": {
          "$ref": "#/definitions/retryConfig"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["version", "agents"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Configuration schema version"
    },
    "defaults": {
      "$ref": "#/definitions/defaults"
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/agent"
      },
      "description": "Map of agent key to agent configuration"
    }
  },
  "additionalProperties": false
}
